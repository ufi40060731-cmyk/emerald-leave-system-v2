# Railway app service
# Add a reference variable pointing at the MySQL service:
# DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql+pymysql://user:password@host:3306/emerald_leave?charset=utf8mb4

# Generate unique secrets in Railway Variables. Never commit real values.
EMERALD_SECRET=replace-with-a-long-random-secret
HOLIDAY_SYNC_KEY=replace-with-another-long-random-secret

ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=
HOLIDAY_SOURCE_TIMEOUT_SECONDS=20
HOLIDAY_AUTO_SYNC_ENABLED=true
HOLIDAY_AUTO_SYNC_HOUR=6
HOLIDAY_AUTO_SYNC_MINUTE=30
HOLIDAY_AUTO_SYNC_STARTUP_DELAY_SECONDS=8

CHATBOT_API_URL=
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_TIMEOUT_SECONDS=30
